# Copy to .env and fill in as needed. Everything below is optional — unset
# means mock mode with no Anthropic key (see backend/README.md for the rest).
# IDEASCOPE_ANTHROPIC_API_KEY=sk-ant-...
# IDEASCOPE_MOCK_GENERATION=true
# When running real mode, IDEASCOPE_SKIP_VALIDATION=true ships each beat's
# generated code as-is (no render-check/auto-fix/vision critique) — a
# deliberate cost/ops trade-off, see docs/PLAN.md's Phase 10 note.
# IDEASCOPE_SKIP_VALIDATION=true
# IDEASCOPE_CORS_ORIGINS=http://localhost:5173
